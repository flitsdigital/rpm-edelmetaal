---
/** Prose die als HTML binnenkomt (CMS-velden, blogtekst).
 *
 *  De koppen, alinea's, lijsten en blockquotes erven de element-regels uit
 *  `base.css` — daar staat de hele schaal al, precies zoals in de export. Hier
 *  staan alleen de dingen die daar níét in zitten.
 *
 *  Dit is de enige plek waar descendant-selectors legitiem zijn: de HTML wordt
 *  op runtime ingevoegd, dus er is geen element om te scopen. Astro's scoped
 *  styles bereiken `set:html`-inhoud niet (astro-gotchas §1).
 */
interface Props {
  html: string;
  class?: string;
}

const { html, class: className } = Astro.props;
---

<div class:list={['richtext', className]} set:html={html} />

<style>
  .richtext :global(> *:last-child) { margin-bottom: 0; } /* guard-ignore: global-css — runtime-HTML, geen element om te scopen */
  .richtext :global(a) { color: var(--primary--accent); } /* guard-ignore: global-css — idem */
  .richtext :global(img) { height: auto; } /* guard-ignore: global-css — idem */
</style>
