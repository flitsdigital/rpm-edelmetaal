---
import Section from './Section.astro';
import Container from '../atoms/Container.astro';
import Row from '../atoms/Row.astro';
import Col from '../atoms/Col.astro';
import Heading from '../atoms/Heading.astro';
import Text from '../atoms/Text.astro';
import PriceRow from '../molecules/PriceRow.astro';
import SectionIntro from './SectionIntro.astro';

export type Prijsgroep = {
  metaal: string;
  symbool: string;

  atoomnummer: number;

  marktprijs: string;

  label: string;

  prijslabel: string;
  titel: string;
  intro: string;

  widget?: string;
  rijen: { nummer: string; gehalte: string; prijs: string; zakelijk?: string }[];
};

interface Props {
  groepen: Prijsgroep[];
  id?: string;

  title?: string;
  text?: string;
}

const { groepen, id = 'prijzen', title, text } = Astro.props;
---
<Section>
  <Container>
    {title && <div class="u-mb-lg"><SectionIntro title={title} text={text} /></div>}
    <div class="tabs">
      {}
      <div class="tabs__menu" role="tablist" aria-label="Kies een edelmetaal" hidden={groepen.length < 2}>
        {
          groepen.map((g, i) => (
            <button
              class="tabs__link"
              type="button"
              role="tab"
              id={`${id}-tab-${i}`}
              aria-controls={`${id}-panel-${i}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
            >
              <span class="tabs__badge" aria-hidden="true">{g.symbool}</span>
              <span>{g.metaal}</span>
            </button>
          ))
        }
      </div>

      {
        groepen.map((g, i) => (
          <div
            class="tabs__pane"
            role="tabpanel"
            id={`${id}-panel-${i}`}
            aria-labelledby={`${id}-tab-${i}`}
            hidden={i > 0}
          >
            <div class="tabs__info">
              <Row align="center">
                <Col lg={g.widget ? 7 : 12} md={12}>
                  <Heading level={2}>{g.titel}</Heading>
                  <div class="tabs__intro">
                    <Text flush>{g.intro}</Text>
                  </div>
                </Col>
                {g.widget && (
                  <Col lg={5} md={12}>
                    <iframe
                      class="tabs__widget"
                      src={g.widget}
                      title={`Live ${g.metaal.toLowerCase()}koers`}
                      height="320"
                      loading="lazy"
                    />
                  </Col>
                )}
              </Row>
            </div>

            <Row gap="md" class="tabs__rows">
              {g.rijen.map((r) => (
                <Col lg={4} md={6} sm={12}>
                  <PriceRow
                    nummer={r.nummer}
                    label={g.label}
                    prijslabel={g.prijslabel}
                    gehalte={r.gehalte}
                    prijs={r.prijs}
                    zakelijk={r.zakelijk}
                    accent={g.metaal === 'Goud'}
                  />
                </Col>
              ))}
            </Row>
          </div>
        ))
      }
    </div>
  </Container>
</Section>

<script>
  document.querySelectorAll<HTMLElement>('.tabs').forEach((tabs) => {
    const links = [...tabs.querySelectorAll<HTMLButtonElement>('.tabs__link')];
    const panes = [...tabs.querySelectorAll<HTMLElement>('.tabs__pane')];

    const activeer = (index: number) => {
      links.forEach((link, i) => {
        link.setAttribute('aria-selected', String(i === index));
        link.tabIndex = i === index ? 0 : -1;
      });
      panes.forEach((pane, i) => {
        pane.hidden = i !== index;
      });
    };

    links.forEach((link, i) => {
      link.addEventListener('click', () => activeer(i));
      link.addEventListener('keydown', (event) => {
        const stap = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
        if (!stap) return;
        event.preventDefault();
        const volgende = (i + stap + links.length) % links.length;
        activeer(volgende);
        links[volgende].focus();
      });
    });
  });
</script>

<style>
  .tabs__menu {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
  }

  .tabs__menu[hidden] {
    display: none;
  }

  .tabs__link {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: .5rem;
    padding: 1.25em 2.5em;
    border: 1px solid var(--_color---neutral--neutral-400);
    background-color: var(--primary--background);
    color: color-mix(in hsl, var(--primary--text) 40%, transparent 60%);
    cursor: pointer;
    transition:
      background-color .3s cubic-bezier(.165, .84, .44, 1),
      border-color .3s cubic-bezier(.165, .84, .44, 1),
      color .3s cubic-bezier(.165, .84, .44, 1);
  }

  .tabs__link:hover {
    color: var(--primary--text);
  }

  .tabs__link[aria-selected='true'] {
    background-color: var(--primary--background-secondary);
    color: var(--primary--text);
  }

  .tabs__link:focus-visible {
    outline: 2px solid var(--primary--accent);
    outline-offset: -2px;
  }

  .tabs__badge {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border: 1px solid var(--_color---neutral--neutral-200);
    font-family: var(--_typography---fonts--heading-font);
    font-size: .675rem;
  }

  .tabs__pane {
    padding-top: var(--_layout---spacing--margin-lg);
  }

  .tabs__info {
    margin-bottom: var(--_layout---spacing--margin-lg);
  }

  .tabs__intro {
    max-width: 35rem;
  }

  .tabs__widget {
    width: 100%;
    border: 0;
    overflow: hidden;
  }

  .tabs__rows {
    row-gap: 2rem;
  }
</style>

<!-- guard-ignore: size-budget — tablist, vier panelen, koerswidget en de prijsrijen.
     De rij zelf is al PriceRow; wat overblijft is het tabs-gedrag met ARIA. -->
