---
/** Knop of knop-vormige link.
 *
 *  Webflow rendert dit als een `<div class="button">` met daarin een
 *  `aria-hidden` label plus een onzichtbare `<a class="u-link-cover">` met
 *  sr-only tekst — een omweg omdat een Webflow-component geen link kan zijn.
 *  Hier is het gewoon een `<a>` of een `<button>`. Visueel identiek, maar wel
 *  één element in plaats van vier, en zonder dubbele toegankelijke naam.
 *  Vastgelegd als bewuste afwijking in FIDELITY.md.
 */
interface Props {
  variant?: 'primary' | 'secondary';
  href?: string;
  type?: 'button' | 'submit';
  full?: boolean;
  disabled?: boolean;
  class?: string;
}

const { variant = 'primary', href, type = 'button', full = false, disabled = false, class: className } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
  class:list={['button', className]}
  data-variant={variant}
  data-full={full ? '' : undefined}
  href={href}
  type={href ? undefined : type}
  disabled={href ? undefined : disabled || undefined}
>
  <slot />
</Tag>

<style>
  .button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: .4em;
    padding: var(--_components---button--vertical-padding) var(--_components---button--horizontal-padding);
    border: 1px solid transparent;
    border-radius: var(--_components---button--border-radius);
    background-color: var(--primary--accent);
    color: var(--_color---neutral--neutral-100);
    font-family: var(--_components---button--font);
    font-size: var(--_components---button--font-size);
    line-height: var(--_components---button--line-height);
    font-weight: var(--_components---button--font-weight);
    letter-spacing: var(--_components---button--letter-spacing);
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    position: relative;
    transition:
      background-color .3s cubic-bezier(.165, .84, .44, 1),
      border-color .3s cubic-bezier(.165, .84, .44, 1);
  }

  .button:hover {
    background-color: var(--_color---primary--gold-600);
  }

  .button:focus-visible {
    outline: 2px solid var(--primary--accent);
    outline-offset: 2px;
  }

  .button[data-variant='secondary'] {
    background-color: color-mix(in hsl, var(--_color---neutral--neutral-100) 15%, transparent 85%);
    color: var(--primary--text);
  }

  .button[data-variant='secondary']:hover {
    background-color: color-mix(in hsl, var(--primary--accent) 10%, transparent 90%);
  }

  .button[data-full] {
    width: 100%;
  }

  .button[disabled] {
    opacity: .5;
    cursor: not-allowed;
  }
</style>

<!-- guard-ignore: size-budget — twee varianten × vier toestanden (default, hover,
     focus-visible, disabled) plus volle breedte. Geen herhaald patroon dat een
     lager component verbergt; de regels zijn allemaal states van deze ene knop. -->
