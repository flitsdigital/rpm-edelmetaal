---
/** Eén gehalte met zijn inkoopprijs, in de grote tabel op /inkoopprijzen.
 *
 *  `zakelijk` is optioneel en wordt alleen meegegeven op de B2B-route. Het is
 *  bewust een aparte prop en géén client-side check: als de waarde er niet is,
 *  staat hij ook niet in de HTML. */
interface Props {
  /** Het getal in het vierkantje, bv. '24' of '925'. */
  nummer: string;
  /** Label ernaast: 'Karaat' bij goud, 'Gehalte' bij de rest. */
  label: string;
  /** 'Prijs particulier:' bij goud, 'Prijs:' bij de rest — zo staat het live. */
  prijslabel: string;
  /** Fijn gehalte als tekst, bv. '999'. */
  gehalte: string;
  prijs: string;
  zakelijk?: string;
  /** Kleurt het nummervierkantje goud op de goud-tab. */
  accent?: boolean;
}

const { nummer, label, prijslabel, gehalte, prijs, zakelijk, accent = false } = Astro.props;
---

<div class="price" data-accent={accent ? '' : undefined}>
  <div class="price__header">
    <div class="price__title">
      <div class="price__nummer">{nummer}</div>
      <div class="price__label h5">{label}</div>
    </div>
  </div>
  <div class="price__row">
    <span class="price__muted">Gehalte:</span>
    <span>{gehalte}</span>
  </div>
  <div class="price__row">
    <span class="price__muted">{prijslabel}</span>
    <span>€ {prijs} p/gram</span>
  </div>
  {
    zakelijk && (
      <div class="price__row">
        <span class="price__muted">Prijs zakelijk:</span>
        <span class="price__zakelijk">€ {zakelijk} p/gram</span>
      </div>
    )
  }
</div>

<style>
  .price {
    display: flex;
    flex-flow: column;
    gap: .5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--primary--background-secondary);
  }

  .price__title {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: .5rem;
  }

  .price__nummer {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 2rem;
    padding-inline: .5rem;
    border: 1px solid var(--primary--text-secondary);
    background-color: var(--primary--background-secondary);
    color: var(--primary--accent-light);
    font-weight: 700;
    text-align: center;
  }

  .price[data-accent] .price__nummer {
    color: var(--_color---primary--gold-500);
    border-color: var(--_color---primary--gold-500);
  }

  .price__label {
    margin-bottom: 0;
  }

  .price__row {
    display: flex;
    gap: .25rem;
  }

  .price__muted {
    opacity: .7;
  }

  .price__zakelijk {
    color: var(--primary--accent-light);
  }
</style>
