---
import BaseLayout from './BaseLayout.astro';
import Navbar from '../components/sections/Navbar.astro';
import Footer from '../components/sections/Footer.astro';
import type { MetaalPrijs } from '../data/site';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;

  current?: string;
  prijzen?: MetaalPrijs[];
  isB2b?: boolean;

  navRuimte?: boolean;

  footer?: boolean;
  banner?: boolean;
  jsonLd?: object[];
}

const {
  title,
  description,
  canonical,
  noindex,
  current,
  prijzen = [],
  isB2b = false,
  navRuimte = true,
  footer = true,
  banner = true,
  jsonLd,
} = Astro.props;
---
<BaseLayout title={title} description={description} canonical={canonical} noindex={noindex} jsonLd={jsonLd}>
  <div class="page">
    <Navbar current={current} prijzen={prijzen} isB2b={isB2b} banner={banner} />
    <main class="page__main" data-nav-ruimte={navRuimte ? '' : undefined}>
      <slot />
    </main>
    {footer && <Footer />}
  </div>
</BaseLayout>

<style>
  .page {
    display: flex;
    flex-flow: column;
    min-height: 100vh;
    position: relative;
    overflow: clip;
    background-color: var(--primary--background);
    color: var(--primary--text);
  }

  .page__main {
    display: flex;
    flex-flow: column;
    flex: 1;
  }

  .page__main[data-nav-ruimte] {
    padding-top: 8rem;
  }
</style>
