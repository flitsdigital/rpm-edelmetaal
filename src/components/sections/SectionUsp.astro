---
import Section from './Section.astro';
import Container from '../atoms/Container.astro';
import Row from '../atoms/Row.astro';
import Col from '../atoms/Col.astro';
import SectionIntro from './SectionIntro.astro';
import UspCard from '../molecules/UspCard.astro';
import Media from '../atoms/Media.astro';
import SectionDivider from '../atoms/SectionDivider.astro';
import type { IconName } from '../../data/icons';
import type { Afbeelding } from '../../data/images';

/** Raster van USP-kaarten, met optionele kop erboven. Drie per rij op desktop.
 *  Dekt zowel het blok van drie op de homepage als dat van zes onder de
 *  taxatie-sectie. */
interface Props {
  title?: string;
  text?: string;
  items: { icon: IconName; title: string; text: string }[];
  /** Volle-breedte beeld boven de sectie, gevolgd door een divider. */
  banner?: Afbeelding;
  paddingTop?: 'default' | 'none';
  paddingBottom?: 'default' | 'none';
}

const { title, text, items, banner, paddingTop = 'default', paddingBottom = 'default' } = Astro.props;
---

<Section paddingTop={paddingTop} paddingBottom={paddingBottom}>
  {
    banner && (
      <>
        <Media src={banner.src} srcset={banner.srcset} sizes={banner.sizes} alt={banner.alt} ratio="4x3" />
        <SectionDivider />
      </>
    )
  }
  <Container>
    {title && <div class="u-mb-lg"><SectionIntro title={title} text={text} /></div>}
    <Row>
      {
        items.map((item) => (
          <Col lg={4} sm={12}>
            <UspCard icon={item.icon} title={item.title} text={item.text} />
          </Col>
        ))
      }
    </Row>
  </Container>
</Section>
