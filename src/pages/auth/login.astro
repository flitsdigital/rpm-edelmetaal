---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionAuth from '../../components/sections/SectionAuth.astro';
import Field from '../../components/molecules/Field.astro';
import Button from '../../components/atoms/Button.astro';
import Text from '../../components/atoms/Text.astro';
import Melding from '../../components/molecules/Melding.astro';
import { maakServerClient } from '../../lib/supabase-server';

export const prerender = false;

const supabase = maakServerClient(Astro);

const gevraagd = Astro.url.searchParams.get('terug') ?? '';
const terug = gevraagd.startsWith('/') && !gevraagd.startsWith('//') ? gevraagd : '/inkoopprijzen-b2b';

const { data: sessie } = await supabase.auth.getUser();
if (sessie.user) return Astro.redirect(terug, 302);

let fout: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const { error } = await supabase.auth.signInWithPassword({
    email: String(form.get('Email') ?? '').trim(),
    password: String(form.get('Password') ?? ''),
  });

  if (!error) return Astro.redirect(terug, 302);
  fout =
    error.code === 'over_request_rate_limit'
      ? 'Te veel pogingen. Wacht even voordat u het opnieuw probeert.'
      : 'E-mailadres of wachtwoord klopt niet.';
}
---
<PageLayout
  title="Inloggen | RPM Edelmetaal"
  current="/auth/login"
  banner={false}
  navRuimte={false}
  footer={false}
  noindex
>
  <SectionAuth title="Inloggen">
    <Text slot="intro" tone="secondary" flush>
      Log hier in. Nog geen account? <a href="/contact">Neem contact op</a>
    </Text>

    {fout && <Melding soort="fout">{fout}</Melding>}

    <form method="post">
      <Field name="Email" label="Email" control="email" placeholder="bijv. naam@mail.com" required autocomplete="email" />
      <Field name="Password" label="Wachtwoord" control="password" required autocomplete="current-password" />
      <Button type="submit">Inloggen</Button>
    </form>

    <div class="u-mt-md">
      <Text size="sm" tone="secondary" flush>
        <a href="/auth/wachtwoord">Wachtwoord vergeten?</a>
      </Text>
    </div>
  </SectionAuth>
</PageLayout>
