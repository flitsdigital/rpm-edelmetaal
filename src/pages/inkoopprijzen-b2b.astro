---
import PageLayout from '../layouts/PageLayout.astro';
import Section from '../components/sections/Section.astro';
import Container from '../components/atoms/Container.astro';
import SectionIntro from '../components/sections/SectionIntro.astro';
import SectionPrijstabel from '../components/sections/SectionPrijstabel.astro';
import SectionCta from '../components/sections/SectionCta.astro';
import { seo, cta } from '../data/content';
import { haalPrijzenB2b } from '../data/prijzen';

export const prerender = false;

const { supabase } = Astro.locals;
if (!supabase) return Astro.redirect('/auth/login', 302);

const { groepen, topPrijzen } = await haalPrijzenB2b(supabase);
---
<PageLayout
  title={seo.b2b.title}
  canonical="https://www.rpmedelmetaal.nl/inkoopprijzen-b2b"
  current="/inkoopprijzen-b2b"
  prijzen={topPrijzen}
  isB2b
  noindex
>
  <Section paddingBottom="none">
    <Container>
      <SectionIntro
        level={1}
        size={2}
        title="Snel en eerlijk inzicht in uw edelmetalen"
        text="Onze zakelijke inkoopprijzen per gram. Deze pagina is alleen zichtbaar voor ingelogde zakelijke klanten."
      />
    </Container>
  </Section>

  <SectionPrijstabel groepen={groepen} id="prijzen-b2b" />

  <SectionCta title={cta.title} text={cta.text} />
</PageLayout>
