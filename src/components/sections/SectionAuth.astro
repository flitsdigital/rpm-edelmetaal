---
import Container from '../atoms/Container.astro';
import Row from '../atoms/Row.astro';
import Col from '../atoms/Col.astro';
import Heading from '../atoms/Heading.astro';
import Text from '../atoms/Text.astro';

/** De kaart op de auth-pagina's. Overgenomen uit `.section_auth` en
 *  `.auth-card` in de Webflow-export: schermvullend, gecentreerd, met een
 *  half-transparante kaart en blur erachter. */
interface Props {
  title: string;
  text?: string;
}

const { title, text } = Astro.props;
---

<section class="auth">
  <Container>
    <Row justify="center">
      <Col lg={8} md={12}>
        <div class="auth__card">
          <div class="u-mb-md">
            <Heading level={1} size={2}>{title}</Heading>
            {text && <Text tone="secondary" flush>{text}</Text>}
          </div>
          <slot />
        </div>
      </Col>
    </Row>
  </Container>
</section>

<style>
  .auth {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    min-height: 100vh;
    padding-block: var(--_components---section--padding);
    background-color: var(--primary--background);
  }

  .auth__card {
    padding: 2rem;
    background-color: color-mix(in hsl, var(--primary--background) 60%, transparent 10%);
    backdrop-filter: blur(5px);
  }
</style>
