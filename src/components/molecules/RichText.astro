---
interface Props {
  html: string;
  class?: string;
}

const { html, class: className } = Astro.props;
---
<div class:list={['richtext', className]} set:html={html} />

<style>
  .richtext :global(> *:last-child) { margin-bottom: 0; } /* guard-ignore: global-css — runtime-HTML, geen element om te scopen */
  .richtext :global(a) { color: var(--primary--accent); } /* guard-ignore: global-css — idem */
  .richtext :global(img) { height: auto; } /* guard-ignore: global-css — idem */
</style>
