---
import Heading from '../atoms/Heading.astro';

/** Compacte prijskaart per metaal — de rij van vier op de homepage. */
interface Props {
  /** Elementsymbool, bv. 'AU'. */
  symbool: string;
  /** Atoomnummer, bv. 79 — staat bovenaan de tegel. */
  atoomnummer: number;
  naam: string;
  /** Marktprijs per gram, 4 decimalen. */
  prijs: string;
  accent?: boolean;
}

const { symbool, atoomnummer, naam, prijs, accent = false } = Astro.props;
---

<div class="card" data-accent={accent ? '' : undefined}>
  <div class="card__icon">
    <div class="h6">{atoomnummer}</div>
    <div class="h3">{symbool}</div>
  </div>
  <div>
    <Heading level={3} size={4}>{naam}</Heading>
    <div>€{prijs} p/gram</div>
  </div>
</div>

<style>
  .card {
    display: flex;
    flex-flow: column;
    justify-content: flex-start;
    align-items: flex-start;
    gap: 2rem;
    padding: 3rem;
    border: 1px solid var(--_color---neutral--neutral-400);
    border-radius: 1px;
  }

  .card__icon {
    display: flex;
    flex-flow: column;
    gap: 1.5rem;
    min-width: 6rem;
    padding: 1rem;
    border: 1px solid var(--primary--accent-light);
    background-color: var(--primary--background-secondary);
  }

  .card[data-accent] .card__icon {
    color: var(--_color---primary--gold-500);
    border-color: var(--_color---primary--gold-500);
  }

  .card__icon > * {
    margin-bottom: 0;
  }
</style>
