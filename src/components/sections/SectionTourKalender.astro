---
import Section from './Section.astro';
import Container from '../atoms/Container.astro';
import Icon from '../atoms/Icon.astro';
import { tourSteden, komendeStops, vandaag, type TourStad, type Stop } from '../../data/tour';

interface Props {
  eyebrow?: string;
  title?: string;
}

const { eyebrow = 'RPM on Tour', title = 'Deze week bij u in de buurt' } = Astro.props;

interface Kaart { stad: TourStad; stop: Stop }

// De week van de vroegste komende stop; stops die al geweest zijn staan gedimd in die week.
const alle: Kaart[] = tourSteden.flatMap((stad) =>
  stad.stops.filter((s) => s.datumISO).map((stop) => ({ stad, stop })),
);
const eersteISO = tourSteden
  .flatMap((stad) => komendeStops(stad).map((s) => s.datumISO!))
  .filter(Boolean)
  .sort()[0];

const iso = (d: Date) => d.toISOString().slice(0, 10);
const maandagVan = (datumISO: string) => {
  const d = new Date(datumISO);
  d.setDate(d.getDate() - ((d.getDay() + 6) % 7));
  return d;
};
const weekNrVan = (maandag: Date) => {
  const d = new Date(maandag);
  d.setDate(d.getDate() + 3);
  const jan4 = new Date(d.getFullYear(), 0, 4);
  return 1 + Math.round(((d.getTime() - jan4.getTime()) / 864e5 - 3 + ((jan4.getDay() + 6) % 7)) / 7);
};

// Alle weken vanaf de week van de eerstvolgende stop die stops hebben; lege weken slaan we over.
const weekStarts = eersteISO
  ? [...new Set(alle.map((k) => iso(maandagVan(k.stop.datumISO!))))].filter((m) => m >= iso(maandagVan(eersteISO))).sort()
  : [];

const maand = (d: Date) => d.toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', timeZone: 'UTC' });
const weken = weekStarts.map((start) => {
  const maandag = new Date(start);
  const dagen = ['Ma', 'Di', 'Wo', 'Do', 'Vr', 'Za', 'Zo'].map((kort, i) => {
    const d = new Date(maandag);
    d.setDate(maandag.getDate() + i);
    return { kort, nr: d.getDate(), iso: iso(d), geweest: iso(d) < vandaag, kaarten: alle.filter((k) => k.stop.datumISO === iso(d)) };
  });
  const zondag = new Date(maandag);
  zondag.setDate(maandag.getDate() + 6);
  return {
    nr: weekNrVan(maandag),
    bereik: `${maand(maandag)} – ${maand(zondag)}`,
    dagen,
    // Za/zo zonder stops krijgen een smalle kolom; de rest is altijd even breed.
    kolommen: dagen.map((d, i) => `minmax(0, ${i >= 5 && d.kaarten.length === 0 ? 1 : 2}fr)`).join(' '),
  };
});
---
{weken.length > 0 && (
  <Section paddingTop="half" paddingBottom="none">
    <Container>
      <div class="kal" data-open="true">
        <button class="kal__kop" type="button" aria-expanded="true" aria-controls="kal-paneel">
          <span class="kal__titel">
            <span class="kal__eyebrow">{eyebrow} · week <span data-weeknr>{weken[0].nr}</span></span>
            <span class="h4">{title}</span>
          </span>
          {weken.map((week, w) => (
          <span class="kal__strook" aria-hidden="true" data-week={w} hidden={w > 0}>
            {week.dagen.map((dag) => (
              <span class="kal__strookdag" data-actief={dag.kaarten.length ? '' : undefined} data-geweest={dag.geweest ? '' : undefined}>
                <small>{dag.kort}</small>{dag.nr}
              </span>
            ))}
          </span>
          ))}
          <span class="kal__chevron"><Icon name="chevron" /></span>
        </button>

        <div class="kal__paneel" id="kal-paneel" role="region">
          <div class="kal__wrap">
            {weken.length > 1 && (
              <div class="kal__nav">
                <button class="kal__pijl" type="button" data-stap="-1" aria-label="Vorige week" disabled><Icon name="chevron" /></button>
                <span class="kal__bereik" aria-live="polite">
                  {weken.map((week, w) => <span data-week={w} data-nr={week.nr} hidden={w > 0}>Week {week.nr} · {week.bereik}</span>)}
                </span>
                <button class="kal__pijl kal__pijl--volgende" type="button" data-stap="1" aria-label="Volgende week"><Icon name="chevron" /></button>
              </div>
            )}
            {weken.map((week, w) => (
            <div class="kal__grid" data-week={w} hidden={w > 0} style={`--kolommen: ${week.kolommen}`}>
              {week.dagen.map((dag) => (
                <div class="kal__dag" data-leeg={dag.kaarten.length === 0 ? '' : undefined} data-geweest={dag.geweest ? '' : undefined}>
                  <div class="kal__dagkop">
                    <span class="kal__eyebrow">{dag.kort}</span>
                    <span class="kal__nr">{dag.nr}</span>
                  </div>
                  <div class="kal__kaarten">
                    {dag.kaarten.length === 0 && <span class="kal__leeg" aria-hidden="true">—</span>}
                    {dag.kaarten.map(({ stad, stop }) => (
                      <a class="kal__kaart" href={`/goud-verkopen/${stad.slug}`}>
                        <span class="h6">{stad.naam}</span>
                        <span class="kal__regel">{stop.locatie}</span>
                        <span class="kal__regel kal__tijd"><Icon name="stopwatch" size="sm" />{stop.tijd}</span>
                      </a>
                    ))}
                  </div>
                </div>
              ))}
            </div>
            ))}
          </div>
        </div>
      </div>
    </Container>
  </Section>
)}

<script>
  // Zelfde mechaniek als AccordionItem: grid-template-rows 0fr → 1fr.
  document.querySelectorAll<HTMLElement>('.kal').forEach((kal) => {
    const knop = kal.querySelector<HTMLButtonElement>('.kal__kop')!;
    knop.addEventListener('click', () => {
      const open = kal.dataset.open !== 'true';
      kal.dataset.open = String(open);
      knop.setAttribute('aria-expanded', String(open));
    });

    // Weeknavigatie: alle weken staan al in de HTML, we wisselen alleen `hidden`.
    const weken = kal.querySelectorAll('.kal__grid').length;
    const pijlen = kal.querySelectorAll<HTMLButtonElement>('.kal__pijl');
    let huidig = 0;
    pijlen.forEach((pijl) => pijl.addEventListener('click', () => {
      huidig = Math.min(weken - 1, Math.max(0, huidig + Number(pijl.dataset.stap)));
      kal.querySelectorAll<HTMLElement>('[data-week]').forEach((el) => (el.hidden = el.dataset.week !== String(huidig)));
      kal.querySelector('[data-weeknr]')!.textContent = kal.querySelector<HTMLElement>(`.kal__bereik [data-week="${huidig}"]`)!.dataset.nr!;
      pijlen[0].disabled = huidig === 0;
      pijlen[1].disabled = huidig === weken - 1;
    }));
  });
</script>

<style>
  .kal { border: 1px solid var(--_color---neutral--neutral-400); }
  .kal a { color: inherit; text-decoration: none; }
  .kal .h4, .kal .h6 { margin: 0; }

  .kal__eyebrow {
    font-family: var(--_typography---eyebrow--font);
    font-size: var(--_typography---eyebrow--font-size);
    font-weight: var(--_typography---eyebrow--font-weight);
    letter-spacing: var(--_typography---eyebrow--letter-spacing);
    line-height: var(--_typography---eyebrow--line-height);
    text-transform: uppercase;
    color: var(--primary--accent);
  }

  .kal__kop {
    display: flex;
    align-items: center;
    gap: var(--_layout---grid--gap-md);
    width: 100%;
    padding: 1.5em;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .kal__kop:focus-visible { outline: 2px solid var(--primary--accent); outline-offset: -2px; }
  .kal[data-open='true'] .kal__kop { border-bottom: 1px solid var(--_color---neutral--neutral-400); }
  .kal__titel { display: flex; flex-flow: column; gap: .4rem; flex: 1; }

  .kal__strook { display: flex; gap: 2px; transition: opacity .3s; }
  .kal[data-open='true'] .kal__strook { opacity: 0; pointer-events: none; }
  .kal__strookdag {
    display: flex;
    flex-flow: column;
    align-items: center;
    width: 2.4rem;
    padding: .35rem 0;
    font-size: .85rem;
    line-height: 1.1;
    color: var(--_color---neutral--neutral-300);
    border-bottom: 2px solid var(--_color---neutral--neutral-400);
  }
  .kal__strookdag small { font-size: .6rem; letter-spacing: .08em; text-transform: uppercase; }
  .kal__strookdag[data-actief] { color: var(--primary--text); border-bottom-color: var(--primary--accent); }
  .kal__strookdag[data-geweest] { opacity: .3; }

  .kal__chevron {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 2em;
    height: 2em;
    color: var(--primary--accent);
    transform: rotate(180deg);
    transition: transform .6s cubic-bezier(.625, .05, 0, 1);
  }
  .kal[data-open='true'] .kal__chevron { transform: rotate(0.001deg); }

  .kal__paneel {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    transition: grid-template-rows .6s cubic-bezier(.625, .05, 0, 1);
  }
  .kal[data-open='true'] .kal__paneel { grid-template-rows: 1fr; }
  .kal__wrap { min-height: 0; overflow: hidden; }

  .kal__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: .75rem 1.25rem;
    border-bottom: 1px solid var(--_color---neutral--neutral-400);
  }
  .kal__bereik { font-size: .875rem; color: var(--primary--text-secondary); text-align: center; }
  .kal__pijl {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--_color---neutral--neutral-400);
    background: transparent;
    color: var(--primary--accent);
    cursor: pointer;
    transform: rotate(-90deg);
    transition: border-color .2s;
  }
  .kal__pijl--volgende { transform: rotate(90deg); }
  .kal__pijl:hover:not(:disabled) { border-color: var(--primary--accent); }
  .kal__pijl:focus-visible { outline: 2px solid var(--primary--accent); outline-offset: 2px; }
  .kal__pijl:disabled { opacity: .25; cursor: default; }
  .kal [hidden] { display: none !important; }

  .kal__grid { display: grid; grid-template-columns: var(--kolommen); }

  .kal__dag { display: flex; flex-flow: column; min-height: 15rem; border-right: 1px solid var(--_color---neutral--neutral-400); }
  .kal__dag:last-child { border-right: 0; }
  .kal__dag[data-leeg] .kal__dagkop { opacity: .35; }
  .kal__dag[data-geweest] .kal__dagkop, .kal__dag[data-geweest] .kal__kaarten { opacity: .2; }
  .kal__dagkop {
    display: flex;
    align-items: baseline;
    gap: .5rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--_color---neutral--neutral-400);
  }
  .kal__nr { font-family: var(--_typography---fonts--heading-font); font-size: 1.75rem; line-height: 1; }

  .kal__kaarten { display: flex; flex-flow: column; gap: .75rem; padding: .75rem; flex: 1; }
  .kal__leeg { color: var(--_color---neutral--neutral-400); text-align: center; margin-top: 1.5rem; font-size: 1.5rem; }
  .kal__kaart {
    display: flex;
    flex-flow: column;
    gap: .3rem;
    padding: 1rem;
    background: var(--primary--background-secondary);
    border: 1px solid var(--_color---neutral--neutral-400);
    border-radius: 1px;
    hyphens: auto;
    overflow-wrap: break-word;
    transition: border-color .2s;
  }
  .kal__kaart .h6 { font-size: clamp(.85rem, 1.1vw, 1.1rem); }
  .kal__kaart:hover { border-color: var(--primary--accent); }
  .kal__regel { font-size: .875rem; color: var(--primary--text-secondary); }
  .kal__tijd { display: flex; align-items: center; gap: .4rem; margin-top: .25rem; font-size: .8rem; white-space: nowrap; }
  .kal__tijd :global(.icon) { color: var(--primary--accent); flex: none; } /* guard-ignore: global-css — Icon draagt zijn eigen scope-hash */

  @media screen and (max-width: 991px) {
    .kal__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .kal__dag { min-height: 0; border-bottom: 1px solid var(--_color---neutral--neutral-400); }
    .kal__dag[data-leeg] { display: none; }
    .kal__strook { display: none; }
  }
  @media screen and (max-width: 767px) {
    .kal__grid { grid-template-columns: 1fr; }
    .kal__dag { border-right: 0; }
  }
</style>
