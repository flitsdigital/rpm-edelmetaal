---
import PageLayout from '../layouts/PageLayout.astro';
import SectionContact from '../components/sections/SectionContact.astro';
import SectionUsp from '../components/sections/SectionUsp.astro';
import SectionOver from '../components/sections/SectionOver.astro';
import SectionDivider from '../components/atoms/SectionDivider.astro';
import Section from '../components/sections/Section.astro';
import Container from '../components/atoms/Container.astro';
import Media from '../components/atoms/Media.astro';
import { seo, contactKaarten, contactSectie } from '../data/content';
import { images } from '../data/images';
import { haalPrijzen } from '../data/prijzen';
const { topPrijzen } = await haalPrijzen();
---

<PageLayout
  title={seo.contact.title}
  description={seo.contact.description}
  canonical="https://www.rpmedelmetaal.nl/contact"
  current="/contact"
  prijzen={topPrijzen}
  navRuimte={false}
>
  <SectionDivider />
  <SectionContact title={contactSectie.title} text={contactSectie.text} formId="taxatie-contact" />

  <SectionUsp items={contactKaarten} />

  <SectionOver
    level={1}
    size={2}
    eyebrow="Contact"
    title="Persoonlijk contact voor een eerlijk advies"
    html="<p>Heeft u vragen of wilt u meer informatie over een gratis taxatie van uw goud, zilver of andere edelmetalen? Neem dan contact met ons op. Wij helpen u graag verder.</p>"
    paddingBottom="default"
  />

  <Section paddingTop="none">
    <Container>
      <Media src={images.team.src} alt={images.team.alt} ratio="16x9" />
    </Container>
  </Section>
</PageLayout>
