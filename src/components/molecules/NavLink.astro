---
/** Navigatielink met de onderstreping die vanuit links inschuift bij hover. */
interface Props {
  href: string;
  current?: boolean;
}

const { href, current = false } = Astro.props;
---

<a class="nav-link" href={href} aria-current={current ? 'page' : undefined}>
  <span class="nav-link__label"><slot /></span>
</a>

<style>
  .nav-link {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: .3em;
    padding: .5rem 1rem;
    opacity: .6;
    color: currentColor;
    text-decoration: none;
    transition: opacity .3s cubic-bezier(.165, .84, .44, 1);
  }

  .nav-link:hover { opacity: .8; }
  .nav-link:focus-visible { color: var(--primary--accent); }

  .nav-link[aria-current='page'] {
    opacity: 1;
    color: var(--_color---primary--gold-100);
    text-decoration: underline;
  }

  .nav-link__label {
    position: relative;
  }

  .nav-link__label::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scale(0, 1);
    transform-origin: right center;
    transition: transform var(--duration-normal) var(--cubic-default);
  }

  .nav-link:hover .nav-link__label::after,
  .nav-link:focus-visible .nav-link__label::after {
    transform: scale(1, 1);
    transform-origin: left center;
  }

  @media screen and (max-width: 991px) {
    .nav-link {
      display: flex;
      justify-content: flex-start;
      width: 100%;
    }
  }

  @media screen and (max-width: 767px) {
    .nav-link {
      opacity: 1;
      color: var(--_color---neutral--neutral-100);
      font-family: var(--_typography---h2--font);
    }

    .nav-link__label { font-size: 2em; }
  }
</style>
