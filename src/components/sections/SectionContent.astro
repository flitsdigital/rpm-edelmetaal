---
import Section from './Section.astro';
import Container from '../atoms/Container.astro';
import Row from '../atoms/Row.astro';
import Col from '../atoms/Col.astro';
import Heading from '../atoms/Heading.astro';
import Eyebrow from '../atoms/Eyebrow.astro';
import Button from '../atoms/Button.astro';
import Media from '../atoms/Media.astro';
import RichText from '../molecules/RichText.astro';
import type { Afbeelding } from '../../data/images';

/** Tekst aan de ene kant, beeld aan de andere. Het meest hergebruikte
 *  sectiepatroon: 7 keer over drie pagina's, met alleen de kant van het beeld
 *  en de inhoud als verschil. */
interface Props {
  eyebrow?: string;
  title: string;
  html: string;
  bullets?: string[];
  ctaLabel?: string;
  ctaHref?: string;
  image: Afbeelding;
  /** Staand kader standaard, zoals op over-ons en testwijze. Een breed onderwerp
   *  — de taxatiewagen bijvoorbeeld — verdrinkt daarin; die krijgt '4x3'. */
  imageRatio?: '3x4' | '4x3' | '1x1' | '16x9';
  imagePosition?: 'left' | 'right';
  paddingTop?: 'default' | 'none';
  paddingBottom?: 'default' | 'none';
  level?: 1 | 2 | 3;
  /** Visuele schaal, los van het element. Standaard gelijk aan `level`. */
  size?: 1 | 2 | 3;
}

const {
  eyebrow,
  title,
  html,
  bullets = [],
  ctaLabel,
  ctaHref,
  image,
  imageRatio = '3x4',
  imagePosition = 'right',
  paddingTop = 'default',
  paddingBottom = 'default',
  level = 2,
  size,
} = Astro.props;
---

<Section paddingTop={paddingTop} paddingBottom={paddingBottom}>
  <Container>
    <Row justify="between">
      {
        imagePosition === 'left' && (
          <Col lg={6} md={12}>
            <Media src={image.src} srcset={image.srcset} sizes={image.sizes} alt={image.alt} ratio={imageRatio} />
          </Col>
        )
      }

      <Col lg={5} md={12}>
        {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
        <Heading level={level} size={size ?? level}>{title}</Heading>
        <RichText html={html} />
        {
          bullets.length > 0 && (
            <ul>
              {bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          )
        }
        {ctaLabel && ctaHref && <div class="content__cta"><Button href={ctaHref}>{ctaLabel}</Button></div>}
      </Col>

      {
        imagePosition === 'right' && (
          <Col lg={6} md={12}>
            <Media src={image.src} srcset={image.srcset} sizes={image.sizes} alt={image.alt} ratio={imageRatio} />
          </Col>
        )
      }
    </Row>
  </Container>
</Section>

<style>
  /* RichText haalt de ondermarge van zijn laatste element weg, en een ul heeft
     zelf geen bovenmarge. Zonder deze regel plakt de lijst tegen de tekst. */
  ul {
    margin-top: var(--_typography---paragraph-body--bottom-margin);
  }

  .content__cta {
    margin-top: var(--_layout---grid--gap-button);
  }
</style>
