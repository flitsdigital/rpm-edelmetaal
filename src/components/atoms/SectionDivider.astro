---
import Logo from './Logo.astro';
---
<div class="divider">
  <div class="divider__line"></div>
  <div class="divider__logo"><Logo variant="mark" /></div>
  <div class="divider__line"></div>
</div>

<style>
  .divider {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    padding-block: var(--_components---section--padding);
  }

  .divider__line {
    flex: 1;
    width: 100%;
    height: 1px;
    background-color: var(--_color---neutral--neutral-400);
  }

  .divider__logo {
    width: 8rem;
    flex: 0 auto;
    color: var(--_color---neutral--neutral-400);
  }

  @media screen and (max-width: 479px) {
    .divider__logo {
      width: 4rem;
    }
  }
</style>
