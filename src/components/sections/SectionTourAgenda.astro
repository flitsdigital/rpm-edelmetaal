---
import Section from './Section.astro';
import Container from '../atoms/Container.astro';
import Row from '../atoms/Row.astro';
import Col from '../atoms/Col.astro';
import Heading from '../atoms/Heading.astro';
import Text from '../atoms/Text.astro';
import TourStop from '../molecules/TourStop.astro';
import { tour, komendeStops, geweestStops, type TourStad } from '../../data/tour';

interface Props {
  stad: TourStad;
  id?: string;
}

const { stad, id } = Astro.props;
const komend = komendeStops(stad);
const geweest = geweestStops(stad);
---
<Section id={id}>
  <Container>
    <Row justify="center">
        <Col lg={10} md={12}>
          <div class="agenda__stops">
            {komend.map((stop) => <TourStop stop={stop} stad={stad} />)}
            {komend.length === 0 && <Text tone="secondary" flush>Wij zijn binnenkort weer in {stad.naam}. {tour.geenStops}</Text>}
          </div>

          {geweest.length > 0 && (
            <div class="agenda__geweest">
              <Heading level={3} size={5}>Eerder waren wij in {stad.naam}</Heading>
              <Text tone="secondary">Onze laatste bezoeken aan {stad.naam}.</Text>
              <div class="agenda__stops">
                {geweest.map((stop) => <TourStop stop={stop} stad={stad} geweest />)}
              </div>
            </div>
          )}
        </Col>
      </Row>
  </Container>
</Section>

<style>
  .agenda__stops {
    display: flex;
    flex-flow: column;
    gap: var(--_layout---grid--gap-sm);
  }

  .agenda__geweest {
    margin-top: var(--_layout---spacing--margin-md);
  }
</style>
