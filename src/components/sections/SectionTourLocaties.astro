---
import Section from './Section.astro';
import Container from '../atoms/Container.astro';
import Row from '../atoms/Row.astro';
import Col from '../atoms/Col.astro';
import SectionIntro from './SectionIntro.astro';
import Button from '../atoms/Button.astro';
import Accordion from '../molecules/Accordion.astro';
import AccordionItem from '../molecules/AccordionItem.astro';
import TourStop from '../molecules/TourStop.astro';
import Text from '../atoms/Text.astro';
import { tourSteden, tour, komendeStops } from '../../data/tour';

interface Props {
  title: string;
  text?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const { title, text, ctaLabel, ctaHref } = Astro.props;

// SEO: alle plaatsnamen (ook afgelopen stops, die pagina's blijven bestaan) als tekst met links.
const links = tourSteden.map((s) => `<a href="/goud-verkopen/${s.slug}">${s.naam}</a>`);
const plaatsenZin = `Wij komen in ${links.slice(0, -1).join(', ')} en ${links.at(-1)}.`;
---
<Section>
  <Container>
    <SectionIntro title={title} text={text} />

    <div class="locaties__plaatsen">
      <Text align="center" tone="secondary" flush>
        <Fragment set:html={plaatsenZin} />
      </Text>
    </div>

    {
      ctaLabel && ctaHref && (
        <div class="locaties__cta">
          <Button href={ctaHref}>{ctaLabel}</Button>
        </div>
      )
    }

    <div class="u-mt-lg">
      <Row justify="center">
        <Col lg={10} md={12}>
          <Accordion id="locaties">
            {
              tourSteden.filter((stad) => komendeStops(stad).length || !stad.stops.length).map((stad, i) => (
                <AccordionItem vraag={stad.naam} open={i === 0} id={`locaties-${i}`}>
                  <div class="locaties__stops">
                    {komendeStops(stad).length > 0 ? (
                      komendeStops(stad).map((stop) => (
                        <TourStop stop={stop} stad={stad} href={`/goud-verkopen/${stad.slug}`} />
                      ))
                    ) : (
                      <Text tone="secondary" flush>
                        {tour.geenStops}
                      </Text>
                    )}
                  </div>
                </AccordionItem>
              ))
            }
          </Accordion>
        </Col>
      </Row>
    </div>
  </Container>
</Section>

<style>
  .locaties__plaatsen {
    max-width: 60ch;
    margin: var(--_layout---spacing--margin-sm) auto 0;
  }
  .locaties__plaatsen a { color: var(--primary--text); }

  .locaties__cta {
    display: flex;
    justify-content: center;
    margin-top: var(--_layout---spacing--margin-md);
  }

  .locaties__stops {
    display: flex;
    flex-flow: column;
    gap: var(--_layout---grid--gap-sm);
  }
</style>
