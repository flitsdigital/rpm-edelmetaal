---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionTourHero from '../../components/sections/SectionTourHero.astro';
import SectionDivider from '../../components/atoms/SectionDivider.astro';
import SectionPrijstabel from '../../components/sections/SectionPrijstabel.astro';
import SectionContent from '../../components/sections/SectionContent.astro';
import SectionUsp from '../../components/sections/SectionUsp.astro';
import SectionFaq from '../../components/sections/SectionFaq.astro';
import SectionContact from '../../components/sections/SectionContact.astro';
import Button from '../../components/atoms/Button.astro';
import { tourSteden, tour, tourUsps, tourFaq, mapsUrl, type TourStad } from '../../data/tour';
import { haalPrijzen } from '../../data/prijzen';
import { images } from '../../data/images';
import { tourEvenementen, faqPageVan } from '../../data/jsonld';

export async function getStaticPaths() {
  return tourSteden.map((stad) => ({ params: { stad: stad.slug }, props: { stad } }));
}

interface Props {
  stad: TourStad;
}

const { stad } = Astro.props;
const { groepen, topPrijzen } = await haalPrijzen();

const goud = groepen.filter((g) => g.metaal === 'Goud');

const eersteStop = stad.stops[0];
const url = `https://www.rpmedelmetaal.nl/goud-verkopen/${stad.slug}`;

const chips = [
  ...(eersteStop
    ? [{ icon: 'calendar' as const, label: eersteStop.datum, datetime: eersteStop.datumISO }]
    : []),
  ...(stad.adres ? [{ icon: 'pin' as const, label: stad.adres }] : []),
];

const vragen = tourFaq(stad.naam);
const evenementen = [...tourEvenementen([stad]), faqPageVan(vragen)];
---
<PageLayout
  title={`Goud verkopen in ${stad.naam} | RPM Edelmetaal`}
  description={`RPM Edelmetaal komt naar ${stad.naam} toe. Bekijk de data en laat uw goud gratis en vrijblijvend taxeren, vlak bij u in de buurt.`}
  canonical={url}
  current="/goud-verkopen"
  prijzen={topPrijzen}
  navRuimte={false}
  jsonLd={evenementen}
>
  <SectionTourHero chips={chips} title={`Goud verkopen in ${stad.naam}`} text={stad.intro}>
    <Button href={mapsUrl(stad)}>Bekijk de locatie op Google</Button>
    <Button variant="secondary" href="#taxatie-stad">Alvast een offerte aanvragen</Button>
  </SectionTourHero>

  <SectionDivider />

  <SectionPrijstabel
    groepen={goud}
    id={`prijzen-${stad.slug}`}
    title="Onze actuele inkoopprijzen"
    text={`Goud verkopen in ${stad.naam}? Dan bent u bij ons aan het juiste adres.`}
  />

  <SectionContent
    eyebrow={tour.eyebrow}
    title={tour.uitleg.titel}
    html={tour.uitleg.tekst
      .split('\n\n')
      .map((p) => `<p>${p}</p>`)
      .join('')}
    image={images[stad.foto]}
    imageRatio="4x3"
  />

  <SectionUsp
    title="Eerlijke taxatie en inkoop van goud, zilver en sieraden"
    text="Wij kopen goud, zilver en andere edelmetalen in — eerlijk, transparant en met persoonlijke aandacht. Kom langs bij een van onze stops of laat uw sieraden gratis en vrijblijvend taxeren."
    items={tourUsps}
  />

  <SectionDivider />

  <SectionFaq
    title="Wij helpen u graag met al uw vragen over onze service"
    text={`Alles over taxeren en verkopen tijdens onze stop in ${stad.naam}. Staat uw vraag er niet bij? Neem gerust contact op.`}
    items={vragen}
    paddingBottom="default"
  />

  <SectionContact title={tour.contact.titel} text={tour.contact.tekst} formId="taxatie-stad" />

  <SectionDivider />
</PageLayout>
