---
interface Props {
  variant?: 'default' | 'nav';
  class?: string;
}

const { variant = 'default', class: className } = Astro.props;
---
<div class:list={['container', variant === 'nav' && 'container--nav', className]}>
  <slot />
</div>

<style>
  .container {
    z-index: 1;
    width: 88%;
    max-width: var(--_components---container--max-width);
    margin-inline: auto;
    display: block;
    position: relative;
  }

  .container--nav {
    gap: 1rem;
    justify-content: space-between;
    align-items: center;
    display: flex;
  }
</style>
