---
interface Props {
  paddingTop?: 'default' | 'none' | 'double' | 'half';
  paddingBottom?: 'default' | 'none' | 'double' | 'half';
  id?: string;
  class?: string;
}

const { paddingTop = 'default', paddingBottom = 'default', id, class: className } = Astro.props;
---
<section class:list={['section', className]} id={id} data-pt={paddingTop} data-pb={paddingBottom}>
  <slot />
</section>

<style>
  .section {
    position: relative;
    padding-top: var(--_components---section--padding);
    padding-bottom: var(--_components---section--padding);
    background-color: var(--primary--background);
  }

  .section[data-pt='none'] { padding-top: 0; }
  .section[data-pb='none'] { padding-bottom: 0; }

  .section[data-pt='double'] { padding-top: var(--_components---section--padding-double); }
  .section[data-pb='double'] { padding-bottom: var(--_components---section--padding-double); }
  .section[data-pt='half'] { padding-top: var(--_components---section--padding-half); }
  .section[data-pb='half'] { padding-bottom: var(--_components---section--padding-half); }
</style>
