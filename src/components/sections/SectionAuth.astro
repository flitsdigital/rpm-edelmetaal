---
import Container from '../atoms/Container.astro';
import Row from '../atoms/Row.astro';
import Col from '../atoms/Col.astro';
import Heading from '../atoms/Heading.astro';
import BgImage from '../atoms/BgImage.astro';
import { images } from '../../data/images';

/** De auth-kaart, overgenomen uit `.section_auth` + `.auth-card`:
 *  schermvullend, links uitgelijnd, half-transparante kaart met blur, over de
 *  achtergrondfoto die ook op de hero staat. */
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="auth">
  <Container>
    <Row justify="center">
      <Col lg={8} md={12}>
        <div class="auth__card">
          <div class="u-mb-md">
            <Heading level={1} size={2}>{title}</Heading>
            <slot name="intro" />
          </div>
          <slot />
        </div>
      </Col>
    </Row>
  </Container>
  <BgImage {...images.achtergrond} />
</section>

<style>
  /* `.section_auth.section` uit de export: schermvullend en verticaal
     gecentreerd. De nav ligt er transparant overheen. */
  .auth {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    height: 100vh;
    position: relative;
    overflow: clip;
  }

  .auth__card {
    padding: 2rem;
    background-color: color-mix(in hsl, var(--primary--background) 60%, transparent 10%);
    backdrop-filter: blur(5px);
  }
</style>
